CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_CSI_WIFI_SSID="Godi Transportes"
CONFIG_CSI_WIFI_PASSWORD="Godi2026"
CONFIG_CSI_NODE_ID="ESP_NODE_01"
CONFIG_CSI_UDP_HOST="192.168.1.26"
CONFIG_CSI_UDP_PORT=9001
# CONFIG_CSI_ENABLE_UART is not set
CONFIG_CSI_UART_BAUD=115200
CONFIG_CSI_UART_TX_QUEUE_LEN=32
